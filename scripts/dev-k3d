#!/usr/bin/env bash
set -euo pipefail

# Single operational entrypoint for the Terraform-owned K3d dev platform.
# Internal state roots remain ordered: cluster -> networking -> gitops on apply,
# and are reversed on destroy.
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
command=${1:-}
kubeconfig=${KUBECONFIG_PATH:-"$HOME/.kube/vixens-dev-k3d.yaml"}
openbao_token_path=${OPENBAO_BOOTSTRAP_TOKEN_PATH:-"$HOME/.secrets/vixens-dev/openbao-token.yaml"}
cluster="$root/terraform/environments/dev-k3d/cluster"
networking="$root/terraform/environments/dev-k3d/networking"
gitops="$root/terraform/environments/dev-k3d/gitops"

usage() {
  printf 'Usage: %s {apply|destroy|plan}\n' "$0" >&2
  exit 64
}

init() {
  terraform -chdir="$1" init -reconfigure -input=false >/dev/null
}

case "$command" in
  apply)
    test -s "$openbao_token_path" || {
      printf 'Missing protected OpenBao bootstrap YAML: %s\n' "$openbao_token_path" >&2
      exit 1
    }
    init "$cluster"
    terraform -chdir="$cluster" apply -input=false -auto-approve \
      -var="kubeconfig_path=$kubeconfig"
    kubectl --kubeconfig="$kubeconfig" get --raw=/readyz >/dev/null

    init "$networking"
    terraform -chdir="$networking" apply -input=false -auto-approve \
      -var="kubeconfig_path=$kubeconfig" \
      -var="k8s_service_host=k3d-vixens-dev-server-0"
    kubectl --kubeconfig="$kubeconfig" -n kube-system rollout status daemonset/cilium --timeout=10m
    kubectl --kubeconfig="$kubeconfig" -n kube-system rollout status deployment/cilium-operator --timeout=10m

    init "$gitops"
    terraform -chdir="$gitops" apply -input=false -auto-approve \
      -var="kubeconfig_path=$kubeconfig" \
      -var="openbao_bootstrap_token_path=$openbao_token_path" \
      -var="bootstrap_enabled=true"
    kubectl --kubeconfig="$kubeconfig" -n argocd rollout status deployment/argocd-server --timeout=10m
    kubectl --kubeconfig="$kubeconfig" -n argocd get application vixens-app-of-apps
    ;;
  destroy)
    # Keep Terraform's normal interactive confirmation for each stateful phase.
    # Never reverse this order: K3d must remain alive until GitOps/Cilium vanish.
    init "$gitops"
    terraform -chdir="$gitops" destroy \
      -var="kubeconfig_path=$kubeconfig" \
      -var="openbao_bootstrap_token_path=$openbao_token_path" \
      -var="bootstrap_enabled=true"

    init "$networking"
    terraform -chdir="$networking" destroy \
      -var="kubeconfig_path=$kubeconfig" \
      -var="k8s_service_host=k3d-vixens-dev-server-0"

    init "$cluster"
    terraform -chdir="$cluster" destroy \
      -var="kubeconfig_path=$kubeconfig"
    ;;
  plan)
    init "$cluster"
    terraform -chdir="$cluster" plan -input=false \
      -var="kubeconfig_path=$kubeconfig"
    ;;
  *) usage ;;
esac
